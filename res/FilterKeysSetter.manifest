<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Merged into the executable by the manifest tool (see AdditionalManifestFiles
    in FilterKeysSetter.vcxproj).

    The dependency on version 6 of the common controls is NOT declared here: it
    is emitted per architecture by the linker pragma in framework.h. Declaring a
    second, x86-only copy here would break the x64 build.
  -->
  <description>Sets the Windows FilterKeys accessibility settings for a faster key repeat.</description>

  <!-- Opt in to the behaviour of modern Windows versions instead of being
       treated as a Windows Vista era application. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Paths longer than MAX_PATH are passed through unmodified. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
